        "delay": "",
        "continue_on_error": false,
        "id": "da0a57eb-f983-4c1a-b36c-cfeb23fa6532",
        "display_text": "Set variable",
        "raw_input": "[{\"Key\": \"VALUE\", \"Value\": \"\"}, {\"Key\": \"ALLOW_USER_INPUT\", \"Value\": \"True\"}, {\"Key\": \"USER_INPUT_TYPE\", \"Value\": \"Text\"}, {\"Key\": \"COMBOBOX_DATA\", \"Value\": \"\"}, {\"Key\": \"INPUT_REQUIRED\", \"Value\": \"True\"}]",

        "delay": "",
        "continue_on_error": false,
        "id": "5472eb2d-9e05-46aa-b39c-d2e4aec123e6",
        "display_text": "Set variable",
        "raw_input": "[{\"Key\": \"VALUE\", \"Value\": \"8000,20000\"}, {\"Key\": \"ALLOW_USER_INPUT\", \"Value\": \"True\"}, {\"Key\": \"USER_INPUT_TYPE\", \"Value\": \"Text\"}, {\"Key\": \"COMBOBOX_DATA\", \"Value\": \"\"}, {\"Key\": \"INPUT_REQUIRED\", \"Value\": \"True\"}]",
        "comment": "Thời gian nghỉ giữa các tài khoản (ví dụ 8 đến 20 giây -> điền 8000,20000)"

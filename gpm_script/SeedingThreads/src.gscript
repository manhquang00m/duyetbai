        "id": "43adaef7-54ed-47b3-b754-7a3f1bd9d645",
        "display_text": "Set variable",
        "raw_input": "[{\"Key\": \"VALUE\", \"Value\": \"1000,2500\"}, {\"Key\": \"ALLOW_USER_INPUT\", \"Value\": \"True\"}, {\"Key\": \"USER_INPUT_TYPE\", \"Value\": \"Text\"}, {\"Key\": \"COMBOBOX_DATA\", \"Value\": \"\"}, {\"Key\": \"INPUT_REQUIRED\", \"Value\": \"True\"}]",
        "comment": "Thời gian chờ sau mỗi thao tác click/gõ (ví dụ 1000,2500)"

        "display_text": "Set variable",
        "raw_input": "[{\"Key\": \"VALUE\", \"Value\": \"$inputExcel[A]\"}, {\"Key\": \"ALLOW_USER_INPUT\", \"Value\": \"False\"}, {\"Key\": \"USER_INPUT_TYPE\", \"Value\": \"Text\"}, {\"Key\": \"COMBOBOX_DATA\", \"Value\": \"\"}, {\"Key\": \"INPUT_REQUIRED\", \"Value\": \"False\"}]",
        "comment": "Username Threads của chính profile = cột A Excel (tool tự loại khỏi target list)"

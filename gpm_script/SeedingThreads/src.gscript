        "type": 1,
        "element_xpath": null,
        "output_variable_name": "doWarmup",
        "delay": "",
        "continue_on_error": false,
        "id": "d0ca66d6-44f5-4c1b-bb24-bbaa9b84a044",
        "display_text": "Set variable",
        "raw_input": "[{\"Key\": \"VALUE\", \"Value\": \"True\"}, {\"Key\": \"ALLOW_USER_INPUT\", \"Value\": \"True\"}, {\"Key\": \"USER_INPUT_TYPE\", \"Value\": \"CheckBox\"}, {\"Key\": \"COMBOBOX_DATA\", \"Value\": \"\"}, {\"Key\": \"INPUT_REQUIRED\", \"Value\": \"True\"}]",
        "comment": "Tích -> làm nóng trước khi seeding (đọc báo + YouTube)"
      },
      {
        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
        "type": 1,
        "element_xpath": null,
        "output_variable_name": "doLike",
        "delay": "",
        "continue_on_error": false,
        "id": "8cf42e79-8600-46ee-8c51-fed2c64dac4e",
        "display_text": "Set variable",
        "raw_input": "[{\"Key\": \"VALUE\", \"Value\": \"True\"}, {\"Key\": \"ALLOW_USER_INPUT\", \"Value\": \"True\"}, {\"Key\": \"USER_INPUT_TYPE\", \"Value\": \"CheckBox\"}, {\"Key\": \"COMBOBOX_DATA\", \"Value\": \"\"}, {\"Key\": \"INPUT_REQUIRED\", \"Value\": \"True\"}]",
        "comment": "Tích -> like bài"
      },
      {
        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
        "type": 1,
        "element_xpath": null,
        "output_variable_name": "doComment",
        "delay": "",
        "continue_on_error": false,
        "id": "92a67fb8-adef-4206-ab69-c14ecea73ec2",
        "display_text": "Set variable",
        "raw_input": "[{\"Key\": \"VALUE\", \"Value\": \"True\"}, {\"Key\": \"ALLOW_USER_INPUT\", \"Value\": \"True\"}, {\"Key\": \"USER_INPUT_TYPE\", \"Value\": \"CheckBox\"}, {\"Key\": \"COMBOBOX_DATA\", \"Value\": \"\"}, {\"Key\": \"INPUT_REQUIRED\", \"Value\": \"True\"}]",
        "comment": "Tích -> comment bài (bỏ tích để chỉ like)"
      },
      {
        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
        "type": 1,
        "element_xpath": null,
        "output_variable_name": "maxAgeHours",
        "delay": "",
        "continue_on_error": false,
        "id": "9feb6e74-f048-484e-adfd-d2aa934cdab9",
        "display_text": "Set variable",
        "raw_input": "[{\"Key\": \"VALUE\", \"Value\": \"24\"}, {\"Key\": \"ALLOW_USER_INPUT\", \"Value\": \"True\"}, {\"Key\": \"USER_INPUT_TYPE\", \"Value\": \"Text\"}, {\"Key\": \"COMBOBOX_DATA\", \"Value\": \"\"}, {\"Key\": \"INPUT_REQUIRED\", \"Value\": \"True\"}]",
        "comment": "Chỉ tương tác bài đăng trong vòng bao nhiêu giờ (ví dụ 24)"
      },
      {
        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
        "type": 1,
        "element_xpath": null,
        "output_variable_name": "scrollTimes",
        "delay": "",
        "continue_on_error": false,
        "id": "5d377270-8c32-43a2-a4a1-d5071badf00d",
        "display_text": "Set variable",
        "raw_input": "[{\"Key\": \"VALUE\", \"Value\": \"15\"}, {\"Key\": \"ALLOW_USER_INPUT\", \"Value\": \"True\"}, {\"Key\": \"USER_INPUT_TYPE\", \"Value\": \"Text\"}, {\"Key\": \"COMBOBOX_DATA\", \"Value\": \"\"}, {\"Key\": \"INPUT_REQUIRED\", \"Value\": \"True\"}]",
        "comment": "Số lần cuộn tối đa trên trang cá nhân để tìm bài (ví dụ 15)"
      },
      {
        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
        "type": 1,
        "element_xpath": null,
        "output_variable_name": "readTime",
        "delay": "",
        "continue_on_error": false,
        "id": "0d774b46-6763-448f-88d6-44a1a0a48440",
        "display_text": "Set variable",
        "raw_input": "[{\"Key\": \"VALUE\", \"Value\": \"2000,5000\"}, {\"Key\": \"ALLOW_USER_INPUT\", \"Value\": \"True\"}, {\"Key\": \"USER_INPUT_TYPE\", \"Value\": \"Text\"}, {\"Key\": \"COMBOBOX_DATA\", \"Value\": \"\"}, {\"Key\": \"INPUT_REQUIRED\", \"Value\": \"True\"}]",
        "comment": "Thời gian xem bài trước khi tương tác (ví dụ 2 đến 5 giây -> điền 2000,5000)"
      },
      {
        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
        "type": 1,
        "element_xpath": null,
        "output_variable_name": "actionDelay",
        "delay": "",
        "continue_on_error": false,
        "id": "e8c83028-0c77-4d77-930f-e991d2521c0e",
        "display_text": "Set variable",
        "raw_input": "[{\"Key\": \"VALUE\", \"Value\": \"1000,2500\"}, {\"Key\": \"ALLOW_USER_INPUT\", \"Value\": \"True\"}, {\"Key\": \"USER_INPUT_TYPE\", \"Value\": \"Text\"}, {\"Key\": \"COMBOBOX_DATA\", \"Value\": \"\"}, {\"Key\": \"INPUT_REQUIRED\", \"Value\": \"True\"}]",
        "comment": "Thời gian chờ sau mỗi thao tác click/gõ (ví dụ 1000,2500)"
      },
      {
        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
        "type": 1,
        "element_xpath": null,
        "output_variable_name": "accountDelay",
        "delay": "",
        "continue_on_error": false,
        "id": "8ad18319-2438-42f3-a4a2-25247010fe68",
        "display_text": "Set variable",
        "raw_input": "[{\"Key\": \"VALUE\", \"Value\": \"8000,20000\"}, {\"Key\": \"ALLOW_USER_INPUT\", \"Value\": \"True\"}, {\"Key\": \"USER_INPUT_TYPE\", \"Value\": \"Text\"}, {\"Key\": \"COMBOBOX_DATA\", \"Value\": \"\"}, {\"Key\": \"INPUT_REQUIRED\", \"Value\": \"True\"}]",
        "comment": "Thời gian nghỉ giữa các tài khoản (ví dụ 8 đến 20 giây -> điền 8000,20000)"
      }
    ],
    "expanded": false,
    "continue_on_error": false,
    "id": "5c4ed33a-a783-4350-b9a7-343c91585ae7",
    "display_text": null,
    "raw_input": null,
    "comment": "Before browser opened"
  },
  "main_logic": {
    "$type": "GPMAutomateEditor.Models.NormalBlockNode, GPMAutomateEditor.Models",
    "nodes": [
      {
        "$type": "GPMAutomateEditor.Models.NormalBlockNode, GPMAutomateEditor.Models",
        "nodes": [
          {
            "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
            "condition": "$targetList contains \"`\" || $targetList contains \"${\" || $commentList contains \"`\" || $commentList contains \"${\" || $selfUser contains \"`\" || $selfUser contains \"${\"",
            "nodes": [
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 117,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": false,
                "id": "9ce82f99-0df0-491e-8734-ee3f30dc587a",
                "display_text": "Throw",
                "raw_input": "[{\"Key\": \"MESSAGE\", \"Value\": \"Ô Excel cột A/B/C chứa ký tự không được phép (dấu ` hoặc ${) -> sửa lại rồi chạy lại\"}]",
                "comment": "stop: unsafe char in excel"
              }
            ],
            "expanded": true,
            "continue_on_error": false,
            "id": "2d206dd4-d23c-4ef8-8a42-0709fdfac2dc",
            "display_text": "If",
            "raw_input": "[{\"Key\": \"CONDITION\", \"Value\": \"$targetList contains \\\"`\\\" || $targetList contains \\\"${\\\" || $commentList contains \\\"`\\\" || $commentList contains \\\"${\\\" || $selfUser contains \\\"`\\\" || $selfUser contains \\\"${\\\"\"}]",
            "comment": "reject unsafe excel cells"
          },
          {
            "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
            "condition": "$doSeeding = \"True\" && $doComment = \"True\" && $commentList = \"\"",
            "nodes": [
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 117,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": false,
                "id": "78e36231-c7a2-44d5-9c07-66bf986cec37",
                "display_text": "Throw",
                "raw_input": "[{\"Key\": \"MESSAGE\", \"Value\": \"Cột C Excel (list comment) đang trống trong khi doComment bật -> điền comment hoặc bỏ tích doComment\"}]",
                "comment": "stop: empty comment list"
              }
            ],
            "expanded": true,
            "continue_on_error": false,
            "id": "f650571b-273c-4a05-816c-35ff890af61b",
            "display_text": "If",
            "raw_input": "[{\"Key\": \"CONDITION\", \"Value\": \"$doSeeding = \\\"True\\\" && $doComment = \\\"True\\\" && $commentList = \\\"\\\"\"}]",
            "comment": "comment list required"
          },
          {
            "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
            "condition": "$doWarmup = \"True\"",
            "nodes": [
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 68,
                "element_xpath": null,
                "output_variable_name": "newsA",
                "delay": "",
                "continue_on_error": false,
                "id": "f8964dc4-8051-4676-9393-3c7af54729f5",
                "display_text": "Execute JS code",
                "raw_input": "[{\"Key\": \"FILE_OR_CODE\", \"Value\": \"var L=[\\\"https://vnexpress.net/\\\", \\\"https://dantri.com.vn/\\\", \\\"https://tuoitre.vn/\\\", \\\"https://thanhnien.vn/\\\", \\\"https://vietnamnet.vn/\\\", \\\"https://znews.vn/\\\", \\\"https://www.24h.com.vn/\\\"];return L[Math.floor(Math.random()*L.length)];\"}]",
                "comment": "pick news site A"
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 68,
                "element_xpath": null,
                "output_variable_name": "newsB",
                "delay": "",
                "continue_on_error": false,
                "id": "92152291-b60f-4183-ac8f-7de83102cb1c",
                "display_text": "Execute JS code",
                "raw_input": "[{\"Key\": \"FILE_OR_CODE\", \"Value\": \"var L=[\\\"https://vnexpress.net/\\\", \\\"https://dantri.com.vn/\\\", \\\"https://tuoitre.vn/\\\", \\\"https://thanhnien.vn/\\\", \\\"https://vietnamnet.vn/\\\", \\\"https://znews.vn/\\\", \\\"https://www.24h.com.vn/\\\"].filter(function(u){return u!==String.raw`$newsA`;});return L[Math.floor(Math.random()*L.length)];\"}]",
                "comment": "pick news site B (different from A)"
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 68,
                "element_xpath": null,
                "output_variable_name": "ytKw",
                "delay": "",
                "continue_on_error": false,
                "id": "d12b71e3-c77d-48a6-9c2c-1d80fd5817fa",
                "display_text": "Execute JS code",
                "raw_input": "[{\"Key\": \"FILE_OR_CODE\", \"Value\": \"var L=[\\\"nhạc chill\\\", \\\"công thức nấu ăn\\\", \\\"du lịch Đà Lạt\\\", \\\"review phim\\\", \\\"mẹo vặt cuộc sống\\\", \\\"bóng đá highlights\\\", \\\"nhạc lofi học bài\\\", \\\"cách pha cà phê\\\", \\\"vlog du lịch\\\", \\\"tập gym tại nhà\\\", \\\"món ngon mỗi ngày\\\", \\\"phim hoạt hình\\\"];return encodeURIComponent(L[Math.floor(Math.random()*L.length)]);\"}]",
                "comment": "pick youtube keyword"
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 39,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": true,
                "id": "ef296306-87e0-43be-91b2-3d008fd7bb6d",
                "display_text": "Go to URL",
                "raw_input": "[{\"Key\": \"URL\", \"Value\": \"$newsA\"}, {\"Key\": \"TIME_OUT\", \"Value\": \"30\"}]",
                "comment": "go to news A"
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 7,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": false,
                "id": "465b7383-963a-4eef-9ef6-bbec41f3af30",
                "display_text": "Delay",
                "raw_input": "[{\"Key\": \"MIN\", \"Value\": \"3000\"}, {\"Key\": \"MAX\", \"Value\": \"5000\"}]",
                "comment": "wait news..."
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 37,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": true,
                "id": "86ef1aeb-65b8-4aea-8a8c-ee06a2deac98",
                "display_text": "Active tab",
                "raw_input": "[{\"Key\": \"ACTIVE_TAB_TYPE\", \"Value\": \"BY_PREFIX_URL\"}, {\"Key\": \"TAB_INDEX_OR_PREFIX_URL\", \"Value\": \"$newsA\"}]",
                "comment": "focus news A tab"
              },
              {
                "$type": "GPMAutomateEditor.Models.ForBlockNode, GPMAutomateEditor.Models",
                "start": "0",
                "end": "4",
                "step": "1",
                "nodes": [
                  {
                    "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                    "type": 53,
                    "element_xpath": null,
                    "output_variable_name": null,
                    "delay": "",
                    "continue_on_error": false,
                    "id": "0b0a8f6f-b865-4e74-a2b5-99a1627e715b",
                    "display_text": "Mouse scroll",
                    "raw_input": "[{\"Key\": \"SCROLL_NUM\", \"Value\": \"2\"}]",
                    "comment": "scroll down"
                  },
                  {
                    "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                    "type": 7,
                    "element_xpath": null,
                    "output_variable_name": null,
                    "delay": "",
                    "continue_on_error": false,
                    "id": "8ce46583-7701-4a86-a978-5057c3f7eee8",
                    "display_text": "Delay",
                    "raw_input": "[{\"Key\": \"MIN\", \"Value\": \"1200\"}, {\"Key\": \"MAX\", \"Value\": \"1800\"}]",
                    "comment": "read news..."
                  }
                ],
                "expanded": true,
                "continue_on_error": false,
                "id": "4adc81f6-3bc2-49eb-ade5-c6386bf53b46",
                "display_text": "For",
                "raw_input": "[{\"Key\": \"START\", \"Value\": \"0\"}, {\"Key\": \"END\", \"Value\": \"4\"}, {\"Key\": \"STEP\", \"Value\": \"1\"}]",
                "comment": "browse 5-7s"
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 39,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": true,
                "id": "5c84ae52-a8ba-4a2c-8467-60f692d301b9",
                "display_text": "Go to URL",
                "raw_input": "[{\"Key\": \"URL\", \"Value\": \"https://www.youtube.com/\"}, {\"Key\": \"TIME_OUT\", \"Value\": \"30\"}]",
                "comment": "go to youtube"
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 7,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": false,
                "id": "562fda08-5c05-47fc-b06a-3175e3340712",
                "display_text": "Delay",
                "raw_input": "[{\"Key\": \"MIN\", \"Value\": \"3000\"}, {\"Key\": \"MAX\", \"Value\": \"5000\"}]",
                "comment": "wait youtube..."
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 39,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": true,
                "id": "7c12ab0e-350b-46b0-be3d-04a84d5f0004",
                "display_text": "Go to URL",
                "raw_input": "[{\"Key\": \"URL\", \"Value\": \"https://www.youtube.com/results?search_query=$ytKw\"}, {\"Key\": \"TIME_OUT\", \"Value\": \"30\"}]",
                "comment": "search keyword"
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 7,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": false,
                "id": "5877b9f6-0f68-4ba4-94dc-7e6b7cd16e4a",
                "display_text": "Delay",
                "raw_input": "[{\"Key\": \"MIN\", \"Value\": \"3000\"}, {\"Key\": \"MAX\", \"Value\": \"5000\"}]",
                "comment": "wait results..."
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 37,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": true,
                "id": "1bb7752b-f104-4f64-bea4-662dccd7aef8",
                "display_text": "Active tab",
                "raw_input": "[{\"Key\": \"ACTIVE_TAB_TYPE\", \"Value\": \"BY_PREFIX_URL\"}, {\"Key\": \"TAB_INDEX_OR_PREFIX_URL\", \"Value\": \"https://www.youtube.com/results\"}]",
                "comment": "focus youtube tab"
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 68,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": true,
                "id": "5e662a1d-3d3e-4b27-985b-2ddff0af7b47",
                "display_text": "Execute JS code",
                "raw_input": "[{\"Key\": \"FILE_OR_CODE\", \"Value\": \"location.reload();return 1;\"}]",
                "comment": "reload results (F5)"
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 7,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": false,
                "id": "d35cceab-1ad8-464a-94a1-b663d2418b89",
                "display_text": "Delay",
                "raw_input": "[{\"Key\": \"MIN\", \"Value\": \"3000\"}, {\"Key\": \"MAX\", \"Value\": \"5000\"}]",
                "comment": "wait reload..."
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 37,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": true,
                "id": "701e6782-4260-40d5-b8ab-b11e2d5b8d84",
                "display_text": "Active tab",
                "raw_input": "[{\"Key\": \"ACTIVE_TAB_TYPE\", \"Value\": \"BY_PREFIX_URL\"}, {\"Key\": \"TAB_INDEX_OR_PREFIX_URL\", \"Value\": \"https://www.youtube.com/results\"}]",
                "comment": "focus youtube tab"

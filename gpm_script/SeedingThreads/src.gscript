                                            "comment": "look around..."
                                          }
                                        ],
                                        "expanded": true,
                                        "continue_on_error": false,
                                        "id": "502ceac0-60de-419b-be14-b2b669e017fd",
                                        "display_text": "If",
                                        "raw_input": "[{\"Key\": \"CONDITION\", \"Value\": \"$curUrl contains \\\"/post/\\\"\"}]",

                                    "continue_on_error": false,
                                    "id": "459a9c2f-bc88-4413-a482-f3e7c69d8e69",
                                    "display_text": "If",
                                    "raw_input": "[{\"Key\": \"CONDITION\", \"Value\": \"$doComment = \\\"True\\\" && hasElement(//div[@data-cur='1']//div[@role='button'][.//*[local-name()='title' and text()='Trả lời']])\"}]",
                                    "comment": "comment post"
                                  },
                                  {
                                    "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                                    "type": 68,
                                    "element_xpath": null,
                                    "output_variable_name": "logLine",
                                    "delay": "",
                                    "continue_on_error": true,
                                    "id": "8f3881fc-d031-4186-8d54-fbc8affe5607",
                                    "display_text": "Execute JS code",
                                    "raw_input": "[{\"Key\": \"FILE_OR_CODE\", \"Value\": \"function A(){function q(v){var s=String(v);if(/^[=+\\\\-@]/.test(s))s=\\\"'\\\"+s;return '\\\"'+s.replace(/\\\"/g,'\\\"\\\"')+'\\\"';}\\nvar d=new Date();function p(n){return (n<10?\\\"0\\\":\\\"\\\")+n;}\\nvar ts=d.getFullYear()+\\\"-\\\"+p(d.getMonth()+1)+\\\"-\\\"+p(d.getDate())+\\\" \\\"+p(d.getHours())+\\\":\\\"+p(d.getMinutes())+\\\":\\\"+p(d.getSeconds());\\nreturn [ts,String.raw`$profileName`,String.raw`$target`,String.raw`$postUrl`,\\\"$liked\\\",\\\"$commented\\\",String.raw`$cmtLog`].map(q).join(\\\",\\\");}\\nreturn A();\"}]",
                                    "comment": "build log line"
                                  },
                                  {
                                    "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                                    "type": 20,
                                    "element_xpath": null,
                                    "output_variable_name": null,
                                    "delay": "",
                                    "continue_on_error": true,
                                    "id": "7b2895a8-c237-4e14-9ea6-1b514ce628bc",
                                    "display_text": "File append line",
                                    "raw_input": "[{\"Key\": \"FILE_PATH\", \"Value\": \"$outputPath\"}, {\"Key\": \"TEXT\", \"Value\": \"$logLine\"}]",
                                    "comment": "log post"
                                  },
                                  {
                                    "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                                    "type": 2,
                                    "element_xpath": null,
                                    "output_variable_name": "picked",
                                    "delay": "",
                                    "continue_on_error": false,
                                    "id": "991fd83f-71ce-4a68-873c-d637b5abd318",
                                    "display_text": "Increase variable",
                                    "raw_input": "[{\"Key\": \"CURRENT_VAL\", \"Value\": \"$picked\"}, {\"Key\": \"INCREASE_BY\", \"Value\": \"1\"}]",
                                    "comment": "count picked post"
                                  },
                                  {
                                    "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
                                    "condition": "$picked >= 1",
                                    "nodes": [
                                      {
                                        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                                        "type": 5,
                                        "element_xpath": null,
                                        "output_variable_name": null,
                                        "delay": "",
                                        "continue_on_error": false,
                                        "id": "8c6e075b-6e56-4223-b9e1-e1f437a6dec3",
                                        "display_text": "Exit loop",
                                        "raw_input": "[]",
                                        "comment": "latest post done"
                                      }
                                    ],
                                    "expanded": true,
                                    "continue_on_error": false,
                                    "id": "97d1e03d-91ef-4108-a2c5-cf750d291ad7",
                                    "display_text": "If",
                                    "raw_input": "[{\"Key\": \"CONDITION\", \"Value\": \"$picked >= 1\"}]",
                                    "comment": "stop while"
                                  }
                                ],
                                "expanded": true,
                                "continue_on_error": false,
                                "id": "bc2f514a-f221-4701-ae64-8c77049c495e",
                                "display_text": "If",
                                "raw_input": "[{\"Key\": \"CONDITION\", \"Value\": \"$ok = \\\"OK\\\"\"}]",
                                "comment": "process post"
                              }
                            ],
                            "expanded": true,
                            "continue_on_error": false,
                            "id": "afe37123-b04a-49b0-a90b-16dee04e6d6b",
                            "display_text": "While",
                            "raw_input": "[{\"Key\": \"CONDITION\", \"Value\": \"hasElement(//div[@data-pressable-container='true'][not(@data-seen)][not(ancestor::div[@data-pressable-container='true'])])\"}]",
                            "comment": "visit unseen posts"
                          },
                          {
                            "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
                            "condition": "$scanDone = \"1\" || $picked >= 1",
                            "nodes": [
                              {
                                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                                "type": 5,

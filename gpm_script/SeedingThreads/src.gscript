        "delay": "",
        "continue_on_error": false,
        "id": "89f49713-7950-4e7c-975f-ead0e8bff1d5",
        "display_text": "Set variable",
        "raw_input": "[{\"Key\": \"VALUE\", \"Value\": \"15\"}, {\"Key\": \"ALLOW_USER_INPUT\", \"Value\": \"True\"}, {\"Key\": \"USER_INPUT_TYPE\", \"Value\": \"Text\"}, {\"Key\": \"COMBOBOX_DATA\", \"Value\": \"\"}, {\"Key\": \"INPUT_REQUIRED\", \"Value\": \"True\"}]",
        "comment": "Số lần cuộn tối đa trên trang cá nhân để tìm bài (ví dụ 15)"

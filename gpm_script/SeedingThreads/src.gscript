                                    "display_text": "Get URL",
                                    "raw_input": "[]",
                                    "comment": "get url"
                                  },
                                  {
                                    "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
                                    "condition": "$curUrl contains \"/post/\"",
                                    "nodes": [
                                      {
                                        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                                        "type": 40,
                                        "element_xpath": null,
                                        "output_variable_name": null,
                                        "delay": "",
                                        "continue_on_error": false,
                                        "id": "c6b0a8dc-70e3-4b18-831f-b3a26ef22841",
                                        "display_text": "Back URL",
                                        "raw_input": "[]",
                                        "comment": "back to profile"
                                      },
                                      {
                                        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                                        "type": 44,
                                        "element_xpath": "//div[@data-pressable-container='true']",
                                        "output_variable_name": null,
                                        "delay": "",
                                        "continue_on_error": true,
                                        "id": "ef2df0c9-4dba-44c1-a245-21861b3a72a8",
                                        "display_text": "Wait element",
                                        "raw_input": "[{\"Key\": \"TIME_OUT\", \"Value\": \"20\"}]",
                                        "comment": "wait profile..."
                                      },
                                      {
                                        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                                        "type": 7,
                                        "element_xpath": null,
                                        "output_variable_name": null,
                                        "delay": "",
                                        "continue_on_error": false,
                                        "id": "4e8563a5-9282-46fc-99c3-ac3b25ba35f3",
                                        "display_text": "Delay",
                                        "raw_input": "[{\"Key\": \"MIN\", \"Value\": \"2000\"}, {\"Key\": \"MAX\", \"Value\": \"3500\"}]",
                                        "comment": "look around..."
                                      }
                                    ],
                                    "expanded": true,
                                    "continue_on_error": false,
                                    "id": "35f721ce-94aa-4208-af7f-35bd38700e65",
                                    "display_text": "If",
                                    "raw_input": "[{\"Key\": \"CONDITION\", \"Value\": \"$curUrl contains \\\"/post/\\\"\"}]",
                                    "comment": "reply opened post page -> go back"
                                  }
                                ],
                                "expanded": true,
                                "continue_on_error": false,
                                "id": "1b996d3b-275d-4209-a4b7-50f645651207",
                                "display_text": "If",
                                "raw_input": "[{\"Key\": \"CONDITION\", \"Value\": \"$doComment = \\\"True\\\" && $cmtCount < $maxComments && hasElement(//div[@data-cur='1']//div[@role='button'][.//*[local-name()='title' and text()='Trả lời']])\"}]",
                                "comment": "comment post"
                              },
                              {
                                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                                "type": 68,
                                "element_xpath": null,
                                "output_variable_name": "logLine",
                                "delay": "",
                                "continue_on_error": true,
                                "id": "45a3e47b-35f4-4d32-aa48-5e2a28ae630a",
                                "display_text": "Execute JS code",
                                "raw_input": "[{\"Key\": \"FILE_OR_CODE\", \"Value\": \"function A(){function q(v){var s=String(v);if(/^[=+\\\\-@]/.test(s))s=\\\"'\\\"+s;return '\\\"'+s.replace(/\\\"/g,'\\\"\\\"')+'\\\"';}\\nvar d=new Date();function p(n){return (n<10?\\\"0\\\":\\\"\\\")+n;}\\nvar ts=d.getFullYear()+\\\"-\\\"+p(d.getMonth()+1)+\\\"-\\\"+p(d.getDate())+\\\" \\\"+p(d.getHours())+\\\":\\\"+p(d.getMinutes())+\\\":\\\"+p(d.getSeconds());\\nreturn [ts,String.raw`$profileName`,String.raw`$target`,String.raw`$postUrl`,\\\"$liked\\\",\\\"$commented\\\",String.raw`$cmtLog`].map(q).join(\\\",\\\");}\\nreturn A();\"}]",
                                "comment": "build log line"
                              },
                              {
                                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                                "type": 20,
                                "element_xpath": null,
                                "output_variable_name": null,
                                "delay": "",
                                "continue_on_error": true,
                                "id": "3b313f5f-cb66-4321-a48a-dbd26707004a",
                                "display_text": "File append line",
                                "raw_input": "[{\"Key\": \"FILE_PATH\", \"Value\": \"$outputPath\"}, {\"Key\": \"TEXT\", \"Value\": \"$logLine\"}]",
                                "comment": "log post"
                              },
                              {
                                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                                "type": 2,
                                "element_xpath": null,
                                "output_variable_name": "picked",
                                "delay": "",
                                "continue_on_error": false,
                                "id": "94915047-3fd0-4538-96b9-6fdf63ee0981",
                                "display_text": "Increase variable",
                                "raw_input": "[{\"Key\": \"CURRENT_VAL\", \"Value\": \"$picked\"}, {\"Key\": \"INCREASE_BY\", \"Value\": \"1\"}]",
                                "comment": "count picked post"
                              },
                              {
                                "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
                                "condition": "$picked >= $postsPerAccount",
                                "nodes": [
                                  {
                                    "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                                    "type": 5,
                                    "element_xpath": null,
                                    "output_variable_name": null,
                                    "delay": "",
                                    "continue_on_error": false,
                                    "id": "0817fae5-1654-4860-b28a-6ece20cf1db6",
                                    "display_text": "Exit loop",
                                    "raw_input": "[]",
                                    "comment": "enough posts for this account"
                                  }
                                ],
                                "expanded": true,
                                "continue_on_error": false,
                                "id": "575ff501-1a0b-4b58-ac9a-7ef36e3a8895",
                                "display_text": "If",
                                "raw_input": "[{\"Key\": \"CONDITION\", \"Value\": \"$picked >= $postsPerAccount\"}]",
                                "comment": "stop while"
                              }
                            ],
                            "expanded": true,
                            "continue_on_error": false,
                            "id": "fd2550d9-6061-4d67-b063-c4dc55f7f72b",
                            "display_text": "If",
                            "raw_input": "[{\"Key\": \"CONDITION\", \"Value\": \"$ok = \\\"OK\\\"\"}]",
                            "comment": "process post"
                          }
                        ],
                        "expanded": true,
                        "continue_on_error": false,
                        "id": "a17eabb6-00bc-4dad-8e80-f520f5f8b0e8",
                        "display_text": "While",
                        "raw_input": "[{\"Key\": \"CONDITION\", \"Value\": \"hasElement(//div[@data-pressable-container='true'][not(@data-seen)][not(ancestor::div[@data-pressable-container='true'])])\"}]",
                        "comment": "visit unseen posts"
                      },
                      {
                        "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
                        "condition": "$scanDone = \"1\" || $picked >= $postsPerAccount",
                        "nodes": [
                          {
                            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                            "type": 5,
                            "element_xpath": null,
                            "output_variable_name": null,
                            "delay": "",
                            "continue_on_error": false,
                            "id": "8f573af5-82fe-4287-8f08-47e156a67b83",
                            "display_text": "Exit loop",
                            "raw_input": "[]",
                            "comment": "done with this profile"
                          }
                        ],
                        "expanded": true,
                        "continue_on_error": false,
                        "id": "21118396-980f-4a4f-84d2-e0cd62cb1eec",
                        "display_text": "If",
                        "raw_input": "[{\"Key\": \"CONDITION\", \"Value\": \"$scanDone = \\\"1\\\" || $picked >= $postsPerAccount\"}]",
                        "comment": "leave scroll loop"
                      },
                      {
                        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                        "type": 53,
                        "element_xpath": null,
                        "output_variable_name": null,
                        "delay": "$actionDelay",
                        "continue_on_error": false,
                        "id": "487873af-fb40-4d46-bac2-50c9940e81aa",
                        "display_text": "Mouse scroll",
                        "raw_input": "[{\"Key\": \"SCROLL_NUM\", \"Value\": \"3\"}]",
                        "comment": "scroll down, loading..."
                      },
                      {
                        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                        "type": 7,
                        "element_xpath": null,
                        "output_variable_name": null,
                        "delay": "",
                        "continue_on_error": false,
                        "id": "2d71278d-aa1e-4081-a9fd-3b24010c8ad3",
                        "display_text": "Delay",
                        "raw_input": "[{\"Key\": \"MIN\", \"Value\": \"1500\"}, {\"Key\": \"MAX\", \"Value\": \"2500\"}]",
                        "comment": "wait render..."
                      }
                    ],
                    "expanded": true,
                    "continue_on_error": false,
                    "id": "45b5ca62-a9de-405a-b833-58cae32ff8ed",
                    "display_text": "For",
                    "raw_input": "[{\"Key\": \"START\", \"Value\": \"0\"}, {\"Key\": \"END\", \"Value\": \"$scrollTimes\"}, {\"Key\": \"STEP\", \"Value\": \"1\"}]",
                    "comment": "scroll + find posts"
                  }
                ],
                "expanded": true,
                "continue_on_error": false,
                "id": "60911b81-fb13-428a-bb96-e2fdb0a6cd26",
                "display_text": "If",
                "raw_input": "[{\"Key\": \"CONDITION\", \"Value\": \"hasElement(//div[@data-pressable-container='true'])\"}]",
                "comment": "profile has posts"
              },
              {
                "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
                "condition": "$picked = 0",
                "nodes": [
                  {
                    "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                    "type": 68,
                    "element_xpath": null,
                    "output_variable_name": "logLine",
                    "delay": "",
                    "continue_on_error": true,
                    "id": "9625662d-9234-4a6c-bd9f-c1f9aada2eb9",
                    "display_text": "Execute JS code",
                    "raw_input": "[{\"Key\": \"FILE_OR_CODE\", \"Value\": \"function A(){function q(v){var s=String(v);if(/^[=+\\\\-@]/.test(s))s=\\\"'\\\"+s;return '\\\"'+s.replace(/\\\"/g,'\\\"\\\"')+'\\\"';}\\nvar d=new Date();function p(n){return (n<10?\\\"0\\\":\\\"\\\")+n;}\\nvar ts=d.getFullYear()+\\\"-\\\"+p(d.getMonth()+1)+\\\"-\\\"+p(d.getDate())+\\\" \\\"+p(d.getHours())+\\\":\\\"+p(d.getMinutes())+\\\":\\\"+p(d.getSeconds());\\nreturn [ts,String.raw`$profileName`,String.raw`$target`,\\\"\\\",\\\"-\\\",\\\"-\\\",\\\"no recent post (or not loaded)\\\"].map(q).join(\\\",\\\");}\\nreturn A();\"}]",
                    "comment": "build log line"
                  },
                  {
                    "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                    "type": 20,
                    "element_xpath": null,
                    "output_variable_name": null,
                    "delay": "",
                    "continue_on_error": true,
                    "id": "d5e15353-d63f-466c-9fb1-e6908c8a488e",
                    "display_text": "File append line",
                    "raw_input": "[{\"Key\": \"FILE_PATH\", \"Value\": \"$outputPath\"}, {\"Key\": \"TEXT\", \"Value\": \"$logLine\"}]",
                    "comment": "log no post"
                  }
                ],
                "expanded": true,
                "continue_on_error": false,
                "id": "f4231872-553f-4aa8-9697-e21a3a8e54d3",
                "display_text": "If",
                "raw_input": "[{\"Key\": \"CONDITION\", \"Value\": \"$picked = 0\"}]",
                "comment": "nothing to engage"
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 11,
                "element_xpath": null,
                "output_variable_name": "rd",
                "delay": "$accountDelay",
                "continue_on_error": false,
                "id": "8e8e36f0-d4b1-465c-9466-65378fb078f2",
                "display_text": "Random number",
                "raw_input": "[{\"Key\": \"MIN\", \"Value\": \"1\"}, {\"Key\": \"MAX\", \"Value\": \"100\"}]",
                "comment": "rest before next account..."
              }
            ],
            "expanded": true,
            "continue_on_error": false,
            "id": "2594b1cd-1d11-406c-99df-9448b4d8cff3",
            "display_text": "For",
            "raw_input": "[{\"Key\": \"START\", \"Value\": \"0\"}, {\"Key\": \"END\", \"Value\": \"$targetCount\"}, {\"Key\": \"STEP\", \"Value\": \"1\"}]",
            "comment": "like + comment each account"
          }
        ],
        "expanded": true,
        "continue_on_error": false,
        "id": "ba70bfb3-7ffa-4d28-b160-0f544b673dc4",
        "display_text": "Normal block",
        "raw_input": null,
        "comment": "threads cross like + comment"
      }

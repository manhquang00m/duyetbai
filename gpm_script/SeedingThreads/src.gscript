                                "raw_input": "[{\"Key\": \"FILE_OR_CODE\", \"Value\": \"function A(){\\ndocument.querySelectorAll(\\\"[data-cur]\\\").forEach(function(e){e.removeAttribute(\\\"data-cur\\\");});\\nvar list=document.querySelectorAll(\\\"div[data-pressable-container='true']:not([data-seen])\\\"),c=null;\\nfor(var i=0;i<list.length;i++){if(list[i].parentElement.closest(\\\"[data-pressable-container]\\\")){list[i].setAttribute(\\\"data-seen\\\",\\\"1\\\");}else{c=list[i];break;}}\\nif(!c)return \\\"NONE\\\";\\nc.setAttribute(\\\"data-seen\\\",\\\"1\\\");\\nvar a=c.querySelector(\\\"a[href*='/post/'] time\\\");\\nif(!a)return \\\"SKIP\\\";\\nvar sp=c.querySelectorAll(\\\"span[dir='auto']\\\");\\nfor(var j=0;j<sp.length;j++){if(sp[j].closest(\\\"[data-pressable-container]\\\")===c&&[\\\"Đã ghim\\\",\\\"Pinned\\\"].indexOf((sp[j].innerText||\\\"\\\").trim())>-1)return \\\"SKIP\\\";}\\nvar url=a.closest(\\\"a\\\").href.split(\\\"?\\\")[0];\\nvar m=url.match(/\\\\/@([^\\\\/]+)\\\\/post\\\\//);\\nif(!m||m[1].toLowerCase()!==String.raw`$target`.toLowerCase())return \\\"SKIP\\\";\\nvar S={};try{S=JSON.parse(sessionStorage.getItem(\\\"__seen\\\")||\\\"{}\\\");}catch(e){}\\nif(S[url])return \\\"SKIP\\\";\\nS[url]=1;try{sessionStorage.setItem(\\\"__seen\\\",JSON.stringify(S));}catch(e){}\\nvar t=new Date(a.getAttribute(\\\"datetime\\\")).getTime();\\nif(Date.now()-t>$maxAgeHours*3600000)return \\\"STOP\\\";\\nwindow.__curUrl=url;\\nc.setAttribute(\\\"data-cur\\\",\\\"1\\\");\\nc.scrollIntoView({behavior:\\\"smooth\\\",block:\\\"center\\\"});\\nreturn \\\"OK\\\";}\\nreturn A();\"}]",

                    "display_text": "Go to URL",
                    "raw_input": "[{\"Key\": \"URL\", \"Value\": \"https://www.threads.com/@$target\"}, {\"Key\": \"TIME_OUT\", \"Value\": \"30\"}]",
                    "comment": "go to target profile"
                  },
                  {
                    "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                    "type": 7,
                    "element_xpath": null,
                    "output_variable_name": null,
                    "delay": "",
                    "continue_on_error": false,
                    "id": "244d7ea1-c24e-40e2-9cce-1b76310f6bf8",
                    "display_text": "Delay",
                    "raw_input": "[{\"Key\": \"MIN\", \"Value\": \"3000\"}, {\"Key\": \"MAX\", \"Value\": \"5000\"}]",
                    "comment": "wait page..."
                  },
                  {
                    "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
                    "condition": "hasElement(//span[contains(text(),'Liên kết không hoạt động')])",
                    "nodes": [
                      {
                        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                        "type": 68,
                        "element_xpath": null,
                        "output_variable_name": "logLine",
                        "delay": "",
                        "continue_on_error": true,
                        "id": "49e03923-f2ef-4091-93c7-457beb95e165",
                        "display_text": "Execute JS code",
                        "raw_input": "[{\"Key\": \"FILE_OR_CODE\", \"Value\": \"function A(){function q(v){var s=String(v);if(/^[=+\\\\-@]/.test(s))s=\\\"'\\\"+s;return '\\\"'+s.replace(/\\\"/g,'\\\"\\\"')+'\\\"';}\\nvar d=new Date();function p(n){return (n<10?\\\"0\\\":\\\"\\\")+n;}\\nvar ts=d.getFullYear()+\\\"-\\\"+p(d.getMonth()+1)+\\\"-\\\"+p(d.getDate())+\\\" \\\"+p(d.getHours())+\\\":\\\"+p(d.getMinutes())+\\\":\\\"+p(d.getSeconds());\\nreturn [ts,String.raw`$profileName`,String.raw`$target`,\\\"\\\",\\\"-\\\",\\\"-\\\",\\\"profile not found\\\"].map(q).join(\\\",\\\");}\\nreturn A();\"}]",
                        "comment": "build log line"
                      },

    "expanded": false,
    "continue_on_error": false,
    "id": "5c4ed33a-a783-4350-b9a7-343c91585ae7",
    "display_text": null,
    "raw_input": null,
    "comment": "Before browser opened"
  },
  "main_logic": {
    "$type": "GPMAutomateEditor.Models.NormalBlockNode, GPMAutomateEditor.Models",
    "nodes": [
      {
        "$type": "GPMAutomateEditor.Models.NormalBlockNode, GPMAutomateEditor.Models",
        "nodes": [
          {
            "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
            "condition": "$targetList contains \"`\" || $targetList contains \"${\" || $commentList contains \"`\" || $commentList contains \"${\" || $selfUser contains \"`\" || $selfUser contains \"${\"",
            "nodes": [
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 117,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": false,
                "id": "fe71e93d-1c2d-45ec-aadf-67037ddd4a8f",
                "display_text": "Throw",
                "raw_input": "[{\"Key\": \"MESSAGE\", \"Value\": \"Ô Excel cột A/B/C chứa ký tự không được phép (dấu ` hoặc ${) -> sửa lại rồi chạy lại\"}]",
                "comment": "stop: unsafe char in excel"
              }
            ],
            "expanded": true,
            "continue_on_error": false,
            "id": "8b1e2bec-8e54-4e57-9771-b0c25e18444b",
            "display_text": "If",
            "raw_input": "[{\"Key\": \"CONDITION\", \"Value\": \"$targetList contains \\\"`\\\" || $targetList contains \\\"${\\\" || $commentList contains \\\"`\\\" || $commentList contains \\\"${\\\" || $selfUser contains \\\"`\\\" || $selfUser contains \\\"${\\\"\"}]",
            "comment": "reject unsafe excel cells"
          },
          {
            "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
            "condition": "$doSeeding != \"False\" && $doSeeding != \"false\" && $doComment != \"False\" && $doComment != \"false\" && $commentList = \"\"",
            "nodes": [
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 117,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": false,
                "id": "8ed916af-c292-4e4f-a973-0c7bc92eed47",
                "display_text": "Throw",
                "raw_input": "[{\"Key\": \"MESSAGE\", \"Value\": \"Cột C Excel (list comment) đang trống trong khi doComment bật -> điền comment hoặc bỏ tích doComment\"}]",
                "comment": "stop: empty comment list"
              }
            ],
            "expanded": true,
            "continue_on_error": false,
            "id": "c6ce63a4-2dba-44bd-93f6-fc964590d110",
            "display_text": "If",
            "raw_input": "[{\"Key\": \"CONDITION\", \"Value\": \"$doSeeding != \\\"False\\\" && $doSeeding != \\\"false\\\" && $doComment != \\\"False\\\" && $doComment != \\\"false\\\" && $commentList = \\\"\\\"\"}]",
            "comment": "comment list required"
          },
          {
            "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
            "condition": "$doWarmup != \"False\" && $doWarmup != \"false\"",
            "nodes": [
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 39,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": true,
                "id": "62a6d8e9-73e8-449c-8d24-d0c3b1f7f3a3",
                "display_text": "Go to URL",
                "raw_input": "[{\"Key\": \"URL\", \"Value\": \"about:blank\"}, {\"Key\": \"TIME_OUT\", \"Value\": \"30\"}]",
                "comment": "open blank page for js"
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 68,
                "element_xpath": null,
                "output_variable_name": "newsA",
                "delay": "",
                "continue_on_error": false,
                "id": "f2fd689e-b489-485c-a96e-4780db81336d",
                "display_text": "Execute JS code",
                "raw_input": "[{\"Key\": \"FILE_OR_CODE\", \"Value\": \"var L=[\\\"https://vnexpress.net/\\\", \\\"https://dantri.com.vn/\\\", \\\"https://tuoitre.vn/\\\", \\\"https://thanhnien.vn/\\\", \\\"https://vietnamnet.vn/\\\", \\\"https://znews.vn/\\\", \\\"https://www.24h.com.vn/\\\"];return L[Math.floor(Math.random()*L.length)];\"}]",
                "comment": "pick news site A"
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 68,
                "element_xpath": null,
                "output_variable_name": "newsB",
                "delay": "",
                "continue_on_error": false,
                "id": "b3807410-38ca-4891-890f-94eba35a3a64",
                "display_text": "Execute JS code",
                "raw_input": "[{\"Key\": \"FILE_OR_CODE\", \"Value\": \"var L=[\\\"https://vnexpress.net/\\\", \\\"https://dantri.com.vn/\\\", \\\"https://tuoitre.vn/\\\", \\\"https://thanhnien.vn/\\\", \\\"https://vietnamnet.vn/\\\", \\\"https://znews.vn/\\\", \\\"https://www.24h.com.vn/\\\"].filter(function(u){return u!==String.raw`$newsA`;});return L[Math.floor(Math.random()*L.length)];\"}]",
                "comment": "pick news site B (different from A)"
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 68,
                "element_xpath": null,
                "output_variable_name": "ytKw",
                "delay": "",
                "continue_on_error": false,
                "id": "10626b54-cfe2-441e-b080-239c61e2790a",
                "display_text": "Execute JS code",
                "raw_input": "[{\"Key\": \"FILE_OR_CODE\", \"Value\": \"var L=[\\\"nhạc chill\\\", \\\"công thức nấu ăn\\\", \\\"du lịch Đà Lạt\\\", \\\"review phim\\\", \\\"mẹo vặt cuộc sống\\\", \\\"bóng đá highlights\\\", \\\"nhạc lofi học bài\\\", \\\"cách pha cà phê\\\", \\\"vlog du lịch\\\", \\\"tập gym tại nhà\\\", \\\"món ngon mỗi ngày\\\", \\\"phim hoạt hình\\\"];return encodeURIComponent(L[Math.floor(Math.random()*L.length)]);\"}]",
                "comment": "pick youtube keyword"
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 39,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": true,
                "id": "223ff0ab-5921-4d1b-acbc-32c439dbd90f",
                "display_text": "Go to URL",
                "raw_input": "[{\"Key\": \"URL\", \"Value\": \"$newsA\"}, {\"Key\": \"TIME_OUT\", \"Value\": \"30\"}]",
                "comment": "go to news A"
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 7,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": false,
                "id": "8a9ce30f-b21d-4fdc-b5cd-3698058a04af",
                "display_text": "Delay",
                "raw_input": "[{\"Key\": \"MIN\", \"Value\": \"3000\"}, {\"Key\": \"MAX\", \"Value\": \"5000\"}]",
                "comment": "wait news..."
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 37,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": true,
                "id": "b12cbf5c-cefe-433b-8571-e4bfba438f94",
                "display_text": "Active tab",
                "raw_input": "[{\"Key\": \"ACTIVE_TAB_TYPE\", \"Value\": \"BY_PREFIX_URL\"}, {\"Key\": \"TAB_INDEX_OR_PREFIX_URL\", \"Value\": \"$newsA\"}]",
                "comment": "focus news A tab"
              },
              {
                "$type": "GPMAutomateEditor.Models.ForBlockNode, GPMAutomateEditor.Models",
                "start": "0",
                "end": "4",
                "step": "1",
                "nodes": [
                  {
                    "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                    "type": 53,
                    "element_xpath": null,
                    "output_variable_name": null,
                    "delay": "",
                    "continue_on_error": false,
                    "id": "84f178da-4d81-4815-a6a5-90bdee586bb2",
                    "display_text": "Mouse scroll",
                    "raw_input": "[{\"Key\": \"SCROLL_NUM\", \"Value\": \"2\"}]",
                    "comment": "scroll down"
                  },
                  {
                    "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                    "type": 7,
                    "element_xpath": null,
                    "output_variable_name": null,
                    "delay": "",
                    "continue_on_error": false,
                    "id": "5b040c08-f8d5-4739-b87a-a6d31a62624e",
                    "display_text": "Delay",
                    "raw_input": "[{\"Key\": \"MIN\", \"Value\": \"1200\"}, {\"Key\": \"MAX\", \"Value\": \"1800\"}]",
                    "comment": "read news..."
                  }
                ],
                "expanded": true,
                "continue_on_error": false,
                "id": "0d0924bd-cbf6-42de-89bd-260e2e0cefd2",
                "display_text": "For",
                "raw_input": "[{\"Key\": \"START\", \"Value\": \"0\"}, {\"Key\": \"END\", \"Value\": \"4\"}, {\"Key\": \"STEP\", \"Value\": \"1\"}]",
                "comment": "browse 5-7s"
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 39,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": true,
                "id": "a17bf651-a03c-4c85-a5f7-a746d02be8bb",
                "display_text": "Go to URL",
                "raw_input": "[{\"Key\": \"URL\", \"Value\": \"https://www.youtube.com/\"}, {\"Key\": \"TIME_OUT\", \"Value\": \"30\"}]",
                "comment": "go to youtube"
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 7,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": false,
                "id": "722955e7-f10b-4afd-ad8f-91ab73b05275",
                "display_text": "Delay",
                "raw_input": "[{\"Key\": \"MIN\", \"Value\": \"3000\"}, {\"Key\": \"MAX\", \"Value\": \"5000\"}]",
                "comment": "wait youtube..."
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 39,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": true,
                "id": "6f7e5194-80b5-438f-84ca-d2ee0989b10a",
                "display_text": "Go to URL",
                "raw_input": "[{\"Key\": \"URL\", \"Value\": \"https://www.youtube.com/results?search_query=$ytKw\"}, {\"Key\": \"TIME_OUT\", \"Value\": \"30\"}]",
                "comment": "search keyword"
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 7,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": false,
                "id": "a7b3fe80-b62c-471e-b539-8723481673e5",
                "display_text": "Delay",
                "raw_input": "[{\"Key\": \"MIN\", \"Value\": \"3000\"}, {\"Key\": \"MAX\", \"Value\": \"5000\"}]",
                "comment": "wait results..."
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 37,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": true,
                "id": "5e59df15-33b3-4ecd-80d2-24c296c59a06",
                "display_text": "Active tab",
                "raw_input": "[{\"Key\": \"ACTIVE_TAB_TYPE\", \"Value\": \"BY_PREFIX_URL\"}, {\"Key\": \"TAB_INDEX_OR_PREFIX_URL\", \"Value\": \"https://www.youtube.com/results\"}]",
                "comment": "focus youtube tab"
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",

                                    "display_text": "If",
                                    "raw_input": "[{\"Key\": \"CONDITION\", \"Value\": \"$doComment != \\\"False\\\" && $doComment != \\\"false\\\" && hasElement(//div[@data-cur='1']//div[@role='button'][.//*[local-name()='title' and text()='Trả lời']])\"}]",

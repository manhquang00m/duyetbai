                    "element_xpath": null,
                    "output_variable_name": "target",
                    "delay": "",
                    "continue_on_error": false,
                    "id": "930a126d-4098-4501-9d3d-9e7b5a192eb5",
                    "display_text": "Execute JS code",
                    "raw_input": "[{\"Key\": \"FILE_OR_CODE\", \"Value\": \"return String.raw`$targetsJoined`.split(\\\",\\\")[$loopIndex]||\\\"\\\";\"}]",
                    "comment": "get target username"
                  },
                  {
                    "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                    "type": 1,
                    "element_xpath": null,

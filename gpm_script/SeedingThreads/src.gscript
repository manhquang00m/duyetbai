            "delay": "",
            "continue_on_error": false,
            "id": "ef9cfdb4-ee0a-40ba-8115-761e5a4ba8c3",
            "display_text": "Set variable",
            "raw_input": "[{\"Key\": \"VALUE\", \"Value\": \"-\"}, {\"Key\": \"ALLOW_USER_INPUT\", \"Value\": \"False\"}, {\"Key\": \"USER_INPUT_TYPE\", \"Value\": \"Text\"}, {\"Key\": \"COMBOBOX_DATA\", \"Value\": \"\"}, {\"Key\": \"INPUT_REQUIRED\", \"Value\": \"False\"}]",
            "comment": null
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 1,
            "element_xpath": null,
            "output_variable_name": "picked",
            "delay": "",
            "continue_on_error": false,
            "id": "3ba3b130-9df1-42b9-a987-c6dda65772f2",
            "display_text": "Set variable",
            "raw_input": "[{\"Key\": \"VALUE\", \"Value\": \"0\"}, {\"Key\": \"ALLOW_USER_INPUT\", \"Value\": \"False\"}, {\"Key\": \"USER_INPUT_TYPE\", \"Value\": \"Text\"}, {\"Key\": \"COMBOBOX_DATA\", \"Value\": \"\"}, {\"Key\": \"INPUT_REQUIRED\", \"Value\": \"False\"}]",
            "comment": null
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 1,
            "element_xpath": null,
            "output_variable_name": "scanDone",
            "delay": "",
            "continue_on_error": false,
            "id": "ca4ab170-a9ec-4ef3-ae1f-417215de778f",
            "display_text": "Set variable",
            "raw_input": "[{\"Key\": \"VALUE\", \"Value\": \"0\"}, {\"Key\": \"ALLOW_USER_INPUT\", \"Value\": \"False\"}, {\"Key\": \"USER_INPUT_TYPE\", \"Value\": \"Text\"}, {\"Key\": \"COMBOBOX_DATA\", \"Value\": \"\"}, {\"Key\": \"INPUT_REQUIRED\", \"Value\": \"False\"}]",
            "comment": null
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 39,
            "element_xpath": null,
            "output_variable_name": null,
            "delay": "",
            "continue_on_error": false,
            "id": "a0bc3ea0-6276-4cf4-967f-bea1485b8932",
            "display_text": "Go to URL",
            "raw_input": "[{\"Key\": \"URL\", \"Value\": \"https://www.threads.com/\"}, {\"Key\": \"TIME_OUT\", \"Value\": \"30\"}]",
            "comment": "go to threads home"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 7,
            "element_xpath": null,
            "output_variable_name": null,
            "delay": "",
            "continue_on_error": false,
            "id": "a7d013ec-ec79-41cb-a6cc-29c01e53e977",
            "display_text": "Delay",
            "raw_input": "[{\"Key\": \"MIN\", \"Value\": \"2500\"}, {\"Key\": \"MAX\", \"Value\": \"4500\"}]",
            "comment": "wait home..."
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 68,
            "element_xpath": null,
            "output_variable_name": "targetsJoined",
            "delay": "",
            "continue_on_error": false,
            "id": "5ea679d5-fbcb-49be-b411-19502d6e10eb",
            "display_text": "Execute JS code",
            "raw_input": "[{\"Key\": \"FILE_OR_CODE\", \"Value\": \"function A(){\\nvar self=String.raw`$selfUser`.trim().replace(/^@/,\\\"\\\").toLowerCase(),seen={},out=[];\\nString.raw`$targetList`.split(/[\\\\r\\\\n,;]+/).forEach(function(v){\\nv=v.trim();var m=v.match(/threads\\\\.(?:com|net)\\\\/@([^\\\\/?#\\\\s]+)/i);if(m)v=m[1];v=v.replace(/^@/,\\\"\\\");\\nif(!/^[A-Za-z0-9._]{1,30}$/.test(v))return;\\nvar k=v.toLowerCase();if(k===self||seen[k])return;seen[k]=1;out.push(v);});\\nfor(var i=out.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=out[i];out[i]=out[j];out[j]=t;}\\ntry{sessionStorage.removeItem(\\\"__seen\\\");}catch(e){}\\nreturn out.join(\\\",\\\");}\\nreturn A();\"}]",
            "comment": "build target list (validate, dedupe, shuffle) -> keep in GPM var, page reloads wipe window"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 68,
            "element_xpath": null,
            "output_variable_name": "targetCount",
            "delay": "",
            "continue_on_error": false,
            "id": "18737681-ceaa-4e12-a200-b8c56aef28f4",
            "display_text": "Execute JS code",
            "raw_input": "[{\"Key\": \"FILE_OR_CODE\", \"Value\": \"var s=String.raw`$targetsJoined`;return s?s.split(\\\",\\\").length:0;\"}]",
            "comment": "count targets"
          },
          {
            "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
            "condition": "$targetCount = 0",
            "nodes": [
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 117,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": false,
                "id": "ca7f550e-6fd0-43fd-822a-c798250ae921",
                "display_text": "Throw",
                "raw_input": "[{\"Key\": \"MESSAGE\", \"Value\": \"Không có tài khoản hợp lệ trong targetList (cần username Threads, ngăn cách bằng dấu phẩy, khác tài khoản của chính profile)\"}]",
                "comment": "stop: empty target list"
              }
            ],
            "expanded": true,
            "continue_on_error": false,
            "id": "673b7e45-1ad2-4809-8cd3-a833b01e0ba2",
            "display_text": "If",
            "raw_input": "[{\"Key\": \"CONDITION\", \"Value\": \"$targetCount = 0\"}]",
            "comment": "no valid target -> stop"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 13,
            "element_xpath": null,
            "output_variable_name": "existsRaw",
            "delay": "",
            "continue_on_error": false,
            "id": "bd2fc868-c50b-405e-8ef4-8ed0640069c7",
            "display_text": "File exists",
            "raw_input": "[{\"Key\": \"FILE_PATH\", \"Value\": \"$outputPath\"}]",
            "comment": "check log file"
          },
          {
            "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
            "type": 68,
            "element_xpath": null,
            "output_variable_name": "exists",
            "delay": "",
            "continue_on_error": true,
            "id": "7d20ba6c-d1e4-4aa4-a445-c9ae026f5870",
            "display_text": "Execute JS code",
            "raw_input": "[{\"Key\": \"FILE_OR_CODE\", \"Value\": \"return String.raw`$existsRaw`.trim().toLowerCase()===\\\"true\\\"?\\\"yes\\\":\\\"no\\\";\"}]",
            "comment": "normalize to yes/no"
          },
          {
            "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
            "condition": "$exists = \"no\"",
            "nodes": [
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 68,
                "element_xpath": null,
                "output_variable_name": "header",
                "delay": "",
                "continue_on_error": false,
                "id": "650630bd-0338-4092-9a7b-30b85d2284c4",
                "display_text": "Execute JS code",
                "raw_input": "[{\"Key\": \"FILE_OR_CODE\", \"Value\": \"return \\\"\\\\uFEFF\\\" + \\\"time,actor,target,postUrl,liked,commented,detail\\\";\"}]",
                "comment": "build csv header"
              },
              {
                "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                "type": 20,
                "element_xpath": null,
                "output_variable_name": null,
                "delay": "",
                "continue_on_error": true,
                "id": "3303d7b7-71ae-4c94-a38c-23a408a0f724",
                "display_text": "File append line",
                "raw_input": "[{\"Key\": \"FILE_PATH\", \"Value\": \"$outputPath\"}, {\"Key\": \"TEXT\", \"Value\": \"$header\"}]",
                "comment": "write header"
              }
            ],
            "expanded": true,
            "continue_on_error": false,
            "id": "6daaa878-a9a0-432c-98d8-37356c5fa279",
            "display_text": "If",
            "raw_input": "[{\"Key\": \"CONDITION\", \"Value\": \"$exists = \\\"no\\\"\"}]",
            "comment": "new log -> header on line 1"
          },
          {

                                            "display_text": "Execute JS code",
                                            "raw_input": "[{\"Key\": \"FILE_OR_CODE\", \"Value\": \"function A(){\\nvar raw=String.raw`$commentList`;\\nvar sep=/[\\\\r\\\\n|]/.test(raw)?/[\\\\r\\\\n|]+/:/,/;\\nvar L=raw.split(sep).map(function(c){return c.trim();}).filter(function(c){return c&&c.length<=500;});\\nvar last=String.raw`$lastComment`,P=L.filter(function(c){return c!==last;});\\nif(!P.length)P=L;\\nreturn P.length?P[Math.floor(Math.random()*P.length)]:\\\"\\\";}\\nreturn A();\"}]",

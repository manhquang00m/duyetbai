                            "display_text": "Delay",
                            "raw_input": "[{\"Key\": \"MIN\", \"Value\": \"1500\"}, {\"Key\": \"MAX\", \"Value\": \"2500\"}]",
                            "comment": "wait render..."
                          }
                        ],
                        "expanded": true,
                        "continue_on_error": false,
                        "id": "543fce4c-578c-411f-b5fa-196d2fab997f",
                        "display_text": "For",
                        "raw_input": "[{\"Key\": \"START\", \"Value\": \"0\"}, {\"Key\": \"END\", \"Value\": \"$scrollTimes\"}, {\"Key\": \"STEP\", \"Value\": \"1\"}]",
                        "comment": "scroll + find posts"
                      }
                    ],
                    "expanded": true,
                    "continue_on_error": false,
                    "id": "27dc8710-7942-4e70-a500-daa0665bac5d",
                    "display_text": "If",
                    "raw_input": "[{\"Key\": \"CONDITION\", \"Value\": \"hasElement(//div[@data-pressable-container='true'])\"}]",
                    "comment": "profile has posts"
                  },
                  {
                    "$type": "GPMAutomateEditor.Models.IfBlockNode, GPMAutomateEditor.Models",
                    "condition": "$picked = 0",
                    "nodes": [
                      {
                        "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                        "type": 68,
                        "element_xpath": null,
                        "output_variable_name": "logLine",
                        "delay": "",
                        "continue_on_error": true,
                        "id": "10c9d76c-22b0-4b91-a9fc-8b3e08c65793",
                        "display_text": "Execute JS code",
                        "raw_input": "[{\"Key\": \"FILE_OR_CODE\", \"Value\": \"function A(){function q(v){var s=String(v);if(/^[=+\\\\-@]/.test(s))s=\\\"'\\\"+s;return '\\\"'+s.replace(/\\\"/g,'\\\"\\\"')+'\\\"';}\\nvar d=new Date();function p(n){return (n<10?\\\"0\\\":\\\"\\\")+n;}\\nvar ts=d.getFullYear()+\\\"-\\\"+p(d.getMonth()+1)+\\\"-\\\"+p(d.getDate())+\\\" \\\"+p(d.getHours())+\\\":\\\"+p(d.getMinutes())+\\\":\\\"+p(d.getSeconds());\\nreturn [ts,String.raw`$profileName`,String.raw`$target`,\\\"\\\",\\\"-\\\",\\\"-\\\",\\\"no recent post (or not loaded)\\\"].map(q).join(\\\",\\\");}\\nreturn A();\"}]",
                        "comment": "build log line"

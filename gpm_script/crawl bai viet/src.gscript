        "display_text": "Set variable",
        "raw_input": "[{\"Key\": \"VALUE\", \"Value\": \"https://www.threads.com/@username\"}, {\"Key\": \"ALLOW_USER_INPUT\", \"Value\": \"True\"}, {\"Key\": \"USER_INPUT_TYPE\", \"Value\": \"Text\"}, {\"Key\": \"COMBOBOX_DATA\", \"Value\": \"\"}, {\"Key\": \"INPUT_REQUIRED\", \"Value\": \"True\"}]",

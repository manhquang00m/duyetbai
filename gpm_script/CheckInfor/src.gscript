                    "display_text": "Execute JS code",
                    "raw_input": "[{\"Key\": \"FILE_OR_CODE\", \"Value\": \"function A(){\\nvar R=/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\\\.[A-Za-z]{2,}/,e=\\\"\\\";\\nvar L=document.querySelectorAll(\\\"[data-email],a[aria-label*='@'],button[aria-label*='@']\\\");\\nfor(var i=0;i<L.length&&!e;i++){var s=L[i].getAttribute(\\\"data-email\\\")||L[i].getAttribute(\\\"aria-label\\\")||\\\"\\\";var m=s.match(R);if(m)e=m[0];}\\nreturn /^[A-Za-z0-9][A-Za-z0-9._%+-]*@[A-Za-z0-9.-]+\\\\.[A-Za-z]{2,}$/.test(e)?e.toLowerCase():\\\"\\\";}\\nreturn A();\"}]",

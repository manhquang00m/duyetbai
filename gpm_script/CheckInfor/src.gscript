                        "comment": "username found"
                      }
                    ],
                    "expanded": true,
                    "continue_on_error": false,
                    "id": "77580b2b-c59b-460c-8f60-9fab788a222b",
                    "display_text": "If",
                    "raw_input": "[{\"Key\": \"CONDITION\", \"Value\": \"$selfName != \\\"\\\"\"}]",
                    "comment": "found -> stop retry"
                  },
                  {
                    "$type": "GPMAutomateEditor.Models.ActionNode, GPMAutomateEditor.Models",
                    "type": 7,
                    "element_xpath": null,
                    "output_variable_name": null,
                    "delay": "",
                    "continue_on_error": false,
                    "id": "23b79e23-0177-44c2-8ccd-cd14d70c6999",
                    "display_text": "Delay",
                    "raw_input": "[{\"Key\": \"MIN\", \"Value\": \"2500\"}, {\"Key\": \"MAX\", \"Value\": \"4000\"}]",

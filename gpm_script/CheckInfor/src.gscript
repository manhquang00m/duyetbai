                    "continue_on_error": false,
                    "id": "e5705367-75d1-495d-843d-1cabde28d2ea",
                    "display_text": "Execute JS code",
                    "raw_input": "[{\"Key\": \"FILE_OR_CODE\", \"Value\": \"function A(){\\nvar svg=document.querySelector(\\\"svg[aria-label='Trang cá nhân'],svg[aria-label='Profile']\\\");\\nvar a=svg?svg.closest(\\\"a\\\"):null;\\nvar m=a?(a.getAttribute(\\\"href\\\")||\\\"\\\").match(/^\\\\/@([^\\\\/?#]+)/):null;\\nvar u=m?m[1]:\\\"\\\";\\nif(!u){var L=document.querySelectorAll(\\\"img[alt^='Ảnh đại diện của ']\\\"),P=\\\"Ảnh đại diện của \\\";\\nfor(var i=0;i<L.length;i++){if(L[i].closest(\\\"[data-pressable-container]\\\"))continue;u=L[i].getAttribute(\\\"alt\\\").slice(P.length).trim();break;}}\\nreturn /^[A-Za-z0-9._]{1,30}$/.test(u)?u:\\\"\\\";}\\nreturn A();\"}]",
